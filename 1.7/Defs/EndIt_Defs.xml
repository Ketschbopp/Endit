<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <JobDef>
    <defName>EndIt_EndIt</defName>
    <driverClass>EndIt.JobDriver_EndIt</driverClass>
    <reportString>ending it.</reportString>
    <playerInterruptible>true</playerInterruptible>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
    <neverShowWeapon>true</neverShowWeapon>
    <alwaysShowReport>true</alwaysShowReport>
  </JobDef>

  <!-- Self-inflicted gunshot. Same wound behaviour as a regular bullet. -->
  <DamageDef>
    <defName>EndIt_SelfShot</defName>
    <label>self-inflicted gunshot</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} died by their own hand.</deathMessage>
    <hediff>Gunshot</hediff>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Bullet</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <overkillPctToDestroyPart>0~0.7</overkillPctToDestroyPart>
    <isRanged>true</isRanged>
    <makesAnimalsFlee>true</makesAnimalsFlee>
  </DamageDef>

  <!-- Self-inflicted blade wound. -->
  <DamageDef>
    <defName>EndIt_SelfCut</defName>
    <label>self-inflicted cut</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} died by their own hand.</deathMessage>
    <hediff>Cut</hediff>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Slice</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <overkillPctToDestroyPart>0~0.7</overkillPctToDestroyPart>
  </DamageDef>

  <!-- Seppuku. Deep abdominal cuts that bleed out rather than kill outright. -->
  <DamageDef>
    <defName>EndIt_Seppuku</defName>
    <label>seppuku</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} died by seppuku.</deathMessage>
    <hediff>Cut</hediff>
    <impactSoundType>Slice</impactSoundType>
    <armorCategory>Sharp</armorCategory>
  </DamageDef>

  <!-- Gunshot execution. Flagged as an execution like vanilla's ExecutionCut. -->
  <DamageDef>
    <defName>EndIt_ExecutionShot</defName>
    <label>execution shot</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <execution>true</execution>
    <deathMessage>{0} has been executed by gunshot.</deathMessage>
    <hediff>Gunshot</hediff>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Bullet</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <overkillPctToDestroyPart>0~0.7</overkillPctToDestroyPart>
    <isRanged>true</isRanged>
    <makesAnimalsFlee>true</makesAnimalsFlee>
  </DamageDef>

  <!-- Shooting a downed enemy. Like the execution shot, but not flagged as an execution. -->
  <DamageDef>
    <defName>EndIt_FinishingShot</defName>
    <label>gunshot</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been shot dead.</deathMessage>
    <hediff>Gunshot</hediff>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Bullet</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <overkillPctToDestroyPart>0~0.7</overkillPctToDestroyPart>
    <isRanged>true</isRanged>
    <makesAnimalsFlee>true</makesAnimalsFlee>
  </DamageDef>

  <!-- Right-click execution of a prisoner or downed enemy with a gun. -->
  <JobDef>
    <defName>EndIt_GunExecution</defName>
    <driverClass>EndIt.JobDriver_GunExecution</driverClass>
    <reportString>executing TargetA.</reportString>
    <playerInterruptible>true</playerInterruptible>
    <casualInterruptible>false</casualInterruptible>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>

  <!-- Russian roulette mental break. Only pawns with a revolver on them can have it. -->
  <MentalBreakDef>
    <defName>EndIt_RussianRoulette</defName>
    <label>Russian roulette</label>
    <mentalState>EndIt_RussianRouletteState</mentalState>
    <workerClass>EndIt.MentalBreakWorker_RussianRoulette</workerClass>
    <baseCommonality>1</baseCommonality>
    <intensity>Extreme</intensity>
  </MentalBreakDef>

  <MentalStateDef>
    <defName>EndIt_RussianRouletteState</defName>
    <label>Russian roulette</label>
    <stateClass>EndIt.MentalState_RussianRoulette</stateClass>
    <category>Misc</category>
    <prisonersCanDo>false</prisonersCanDo>
    <slavesCanDo>true</slavesCanDo>
    <stopsJobs>true</stopsJobs>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <!-- The job ends the state after six pulls (or a live round); this is only a safety net. -->
    <minTicksBeforeRecovery>20000</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>20000</maxTicksBeforeRecovery>
    <recoveryMtbDays>1000</recoveryMtbDays>
    <recoverFromSleep>true</recoverFromSleep>
    <recoverFromDowned>true</recoverFromDowned>
    <recoverFromCaptured>true</recoverFromCaptured>
    <recoverFromCollapsingExhausted>true</recoverFromCollapsingExhausted>
    <nameColor>(0.85, 0.3, 0.3)</nameColor>
    <beginLetterLabel>Russian roulette</beginLetterLabel>
    <beginLetter>{0} has given up and is going to play Russian roulette with a revolver.\n\nOne bullet, six chambers, six pulls of the trigger.</beginLetter>
    <beginLetterDef>ThreatSmall</beginLetterDef>
    <recoveryMessage>{0} has put the revolver down.</recoveryMessage>
    <baseInspectLine>Mental state: Russian roulette</baseInspectLine>
    <allowBeatfire>false</allowBeatfire>
  </MentalStateDef>

  <JobDef>
    <defName>EndIt_RussianRoulette</defName>
    <driverClass>EndIt.JobDriver_RussianRoulette</driverClass>
    <reportString>playing Russian roulette.</reportString>
    <playerInterruptible>false</playerInterruptible>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
    <neverShowWeapon>true</neverShowWeapon>
    <alwaysShowReport>true</alwaysShowReport>
  </JobDef>

</Defs>
