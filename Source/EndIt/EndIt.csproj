<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- RimWorld 1.7 runs on .NET 10 (Waylith); mods target net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>EndIt</AssemblyName>
    <RootNamespace>EndIt</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>..\..\1.7\Assemblies</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- RimWorld 1.7 reference assemblies. No game install needed. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.2" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\1.7\**\*.xml" Link="ModXML\1.7\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\Languages\**\*.xml" Link="ModXML\Languages\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\About\*.xml" Link="ModXML\About\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
